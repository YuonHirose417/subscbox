# コピーして .env を作る（.env はコミットしない）。EAS Build では同じ名前の環境変数を EAS に登録する。
# RevenueCat の公開用 iOS SDK キー（appl_ で始まる。シークレットキーは絶対に入れない）
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# AdMob のアプリ ID（ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy）
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# AdMob のバナー広告ユニット ID（ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz）。未設定なら本番では広告を出さない
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
